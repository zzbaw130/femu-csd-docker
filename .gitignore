/qmp-sock
/log
*.qcow2
provision.log
.make-guest-image/

# 与 FEMU 部署无关的独立上游 checkout（自带 git 历史）
/code/postgres/

# 编辑器/系统噪声
*.swp
*.orig
*.rej
.DS_Store
