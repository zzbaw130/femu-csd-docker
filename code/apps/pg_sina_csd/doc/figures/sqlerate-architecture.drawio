" target="release"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="674" y="1460"/><mxPoint x="805" y="1460"/></Array></mxGeometry></mxCell><mxCell id="dcp-done" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#b76a20;strokeWidth=2;endArrow=block;endFill=1;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;fontSize=13;fontColor=#b76a20;fontFamily=Noto Sans CJK SC;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=7;" edge="1" parent="connections" source="dcp-target" target="release"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1306" y="1460"/><mxPoint x="1155" y="1460"/></Array></mxGeometry></mxCell><mxCell id="input" value="只读 FDM 输入&#xa;CU 与 DMA 共用原始页&#xa;不复制一份设备中转块" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f2f4f7;strokeColor=#a3adba;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="260" y="185" width="300" height="125" as="geometry"/></mxCell><mxCell id="pool" value="128 项任务元数据&#xa;AFDM 引用 / LBA / 偏移&#xa;输入区间及 DMA 状态" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecf6f0;strokeColor=#8bb9a0;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="630" y="185" width="320" height="125" as="geometry"/></mxCell><mxCell id="dispatch-rule" value="FTL 派发&#xa;优先选择所属槽组有空位者&#xa;worker 实际原子预留确认" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecf6f0;strokeColor=#8bb9a0;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1030" y="185" width="340" height="125" as="geometry"/></mxCell><mxCell id="lane0" value="lane 0 · 64 项&#xa;FTL 单生产者&#xa;submitted / completed / collected" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecf6f0;strokeColor=#8bb9a0;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="260" y="470" width="300" height="115" as="geometry"/></mxCell><mxCell id="worker0" value="DMA worker 0&#xa;预留槽、复制、链路计时&#xa;只向 Guest 队列 0、2 发布" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecf6f0;strokeColor=#8bb9a0;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="630" y="470" width="320" height="115" as="geometry"/></mxCell><mxCell id="lane1" value="lane 1 · 64 项&#xa;FTL 单生产者&#xa;submitted / completed / collected" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecf6f0;strokeColor=#8bb9a0;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1030" y="470" width="300" height="115" as="geometry"/></mxCell><mxCell id="worker1" value="DMA worker 1&#xa;预留槽、复制、链路计时&#xa;只向 Guest 队列 1、3 发布" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecf6f0;strokeColor=#8bb9a0;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1400" y="470" width="320" height="115" as="geometry"/></mxCell><mxCell id="slot0" value="槽组 0 / 就绪队列 0&#xa;4 个 4MiB + 32 个 64KiB 槽&#xa;环 37 项，仅传槽号&#xa;ready / HPCP / DCP 独立状态" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff6e5;strokeColor=#ccb47b;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="260" y="790" width="300" height="125" as="geometry"/></mxCell><mxCell id="slot2" value="槽组 2 / 就绪队列 2&#xa;4 个 4MiB + 32 个 64KiB 槽&#xa;环 37 项，仅传槽号&#xa;ready / HPCP / DCP 独立状态" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff6e5;strokeColor=#ccb47b;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="630" y="790" width="300" height="125" as="geometry"/></mxCell><mxCell id="slot1" value="槽组 1 / 就绪队列 1&#xa;4 个 4MiB + 32 个 64KiB 槽&#xa;环 37 项，仅传槽号&#xa;ready / HPCP / DCP 独立状态" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff6e5;strokeColor=#ccb47b;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1030" y="790" width="300" height="125" as="geometry"/></mxCell><mxCell id="slot3" value="槽组 3 / 就绪队列 3&#xa;4 个 4MiB + 32 个 64KiB 槽&#xa;环 37 项，仅传槽号&#xa;ready / HPCP / DCP 独立状态" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff6e5;strokeColor=#ccb47b;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1400" y="790" width="320" height="125" as="geometry"/></mxCell><mxCell id="guest0" value="HPCP worker 0&#xa;只消费队列 0 → PUBLISH" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f3edfa;strokeColor=#b29ac9;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="260" y="1070" width="300" height="80" as="geometry"/></mxCell><mxCell id="guest2" value="HPCP worker 2&#xa;只消费队列 2 → PUBLISH" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f3edfa;strokeColor=#b29ac9;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="630" y="1070" width="300" height="80" as="geometry"/></mxCell><mxCell id="guest1" value="HPCP worker 1&#xa;只消费队列 1 → PUBLISH" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f3edfa;strokeColor=#b29ac9;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1030" y="1070" width="300" height="80" as="geometry"/></mxCell><mxCell id="guest3" value="HPCP worker 3&#xa;只消费队列 3 → PUBLISH" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f3edfa;strokeColor=#b29ac9;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1400" y="1070" width="320" height="80" as="geometry"/></mxCell><mxCell id="hpcp-target" value="HPCP · Guest 内核&#xa;接收页 → Linux 文件页缓存（4KiB）&#xa;已有有效页跳过；缺页按非阻塞准入创建" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff6e5;strokeColor=#ccb47b;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="260" y="1290" width="690" height="110" as="geometry"/></mxCell><mxCell id="dcp-target" value="DCP · 查询 PG 后端&#xa;同一数据区只读 mmap → shared_buffers（8KiB）&#xa;ACQUIRE / RELEASE；不消费 HPCP 槽号队列" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#edf4ff;strokeColor=#91aed1;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1030" y="1290" width="690" height="110" as="geometry"/></mxCell><mxCell id="shared-data" value="同一个共享接收数据区：DCP 可读取所有槽组，不消耗 HPCP 就绪队列的槽号" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff6e5;strokeColor=#ccb47b;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="260" y="937" width="1460" height="35" as="geometry"/></mxCell><mxCell id="release" value="femu_cache.ko 槽生命周期&#xa;所有启用目标完成 → ready = 0 → 归还 Guest 槽&#xa;FDM 可在 CU 与实际 DMA 安全结束后更早复用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff6e5;strokeColor=#ccb47b;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="630" y="1490" width="700" height="95" as="geometry"/></mxCell><mxCell id="q-title" value="HPCP / DCP · 派发、接收槽与消费者" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#18324c;fontStyle=1;" vertex="1" parent="notes"><mxGeometry x="40" y="25" width="1670" height="45" as="geometry"/></mxCell><mxCell id="q-subtitle" value="设备队列保存任务引用；Guest 槽保存数据；就绪队列仅传槽号。三者不是同一种缓冲。" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#425267;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="42" y="76" width="1670" height="25" as="geometry"/></mxCell><mxCell id="q-dev-label" value="设备：FTL" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#243449;fontStyle=1;" vertex="1" parent="notes"><mxGeometry x="50" y="141" width="180" height="70" as="geometry"/></mxCell><mxCell id="q-dev-sub" value="单一调度者&#xa;登记与派发可选填充" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#637185;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="50" y="224" width="178" height="130" as="geometry"/></mxCell><mxCell id="admission" value="可选填充可丢弃：&#xa;设备任务池满、Guest 槽满、&#xa;尚未 DMA 的输入将被覆盖。&#xa;&#xa;FTL / CU 不等缓存空槽。" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#425267;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="1430" y="180" width="275" height="150" as="geometry"/></mxCell><mxCell id="dma-band-label" value="设备：DMA" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#243449;fontStyle=1;" vertex="1" parent="notes"><mxGeometry x="50" y="426" width="180" height="70" as="geometry"/></mxCell><mxCell id="dma-band-sub" value="2 条独立后台 worker&#xa;完成游标与结果返回 FTL" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#637185;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="50" y="509" width="178" height="120" as="geometry"/></mxCell><mxCell id="dma-completion-note" value="每 worker 保留 publication FIFO：软件复制与共享 PCIe 链路均完成后，直接发布描述符，无需重新派发。" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=15;fontColor=#425267;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="70" y="1685" width="1660" height="45" as="geometry"/></mxCell><mxCell id="wire-note" value="queue = slot % 4；DMA worker = queue % 2。每条就绪队列只有一个设备发布者和一个 Guest HPCP 消费者。" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#236d55;fontStyle=1;" vertex="1" parent="notes"><mxGeometry x="70" y="1750" width="1660" height="40" as="geometry"/></mxCell><mxCell id="slots-band-label" value="Guest 内核&#xa;DMA 接收区" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#243449;fontStyle=1;" vertex="1" parent="notes"><mxGeometry x="50" y="751" width="180" height="70" as="geometry"/></mxCell><mxCell id="slots-band-sub" value="固定 DMA 页&#xa;16 大槽 + 128 小槽&#xa;72MiB 数据 / 12KiB 描述" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#637185;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="50" y="834" width="178" height="130" as="geometry"/></mxCell><mxCell id="guest-workers-label" value="Guest：SNIA 插件" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#243449;fontStyle=1;" vertex="1" parent="notes"><mxGeometry x="50" y="1036" width="180" height="70" as="geometry"/></mxCell><mxCell id="guest-workers-sub" value="4 条库内 HPCP 线程&#xa;不是设备 CU 或 PG worker" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#637185;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="50" y="1119" width="178" height="60" as="geometry"/></mxCell><mxCell id="targets-label" value="Guest：缓存目标" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#243449;fontStyle=1;" vertex="1" parent="notes"><mxGeometry x="50" y="1256" width="180" height="70" as="geometry"/></mxCell><mxCell id="targets-sub" value="同一接收数据&#xa;两个独立消费者" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#637185;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="50" y="1339" width="178" height="85" as="geometry"/></mxCell><mxCell id="end-note" value="一次 DMA，两个目标复制；设备任务记录、FDM 输入、Guest 接收槽分别退还。&#xa;Guest 安装缓存的速度影响后续空槽，但不要求设备保留 FDM 到缓存安装完成。" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#425267;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="70" y="1620" width="1660" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
