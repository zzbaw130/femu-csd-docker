;fillColor=#edf4ff;strokeColor=#91aed1;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1040" y="160" width="310" height="100" as="geometry"/></mxCell><mxCell id="consumers" value="PG 原生并行参与者&#xa;通过 DSM 消费共享扫描结果" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#edf4ff;strokeColor=#91aed1;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1040" y="285" width="310" height="85" as="geometry"/></mxCell><mxCell id="database" value="Database Cache&#xa;PG shared_buffers&#xa;&#xa;DCP：查询 PG 后端导入&#xa;ReadBufferExtended&#xa;同一接收页 → 8KiB 缓冲" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#edf4ff;strokeColor=#91aed1;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1430" y="160" width="290" height="210" as="geometry"/></mxCell><mxCell id="api" value="libsnia.so · 公开 cs.h&#xa;句柄 / 请求快照 / 引用&#xa;异步请求、event、batch" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f3edfa;strokeColor=#b29ac9;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="260" y="490" width="310" height="105" as="geometry"/></mxCell><mxCell id="adapter" value="cs-femu.so · FEMU 插件&#xa;NVMe 命令与 E9 图编码&#xa;图会话、AFDM、CSF 映射" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f3edfa;strokeColor=#b29ac9;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="650" y="490" width="310" height="105" as="geometry"/></mxCell><mxCell id="context" value="连接级资源&#xa;设备句柄 / 14 个 CSF 入口&#xa;CU、FDM、workmem 快照" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f3edfa;strokeColor=#b29ac9;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1040" y="490" width="310" height="105" as="geometry"/></mxCell><mxCell id="hpcp" value="4 条 Guest HPCP 线程&#xa;每线程消费一条就绪队列&#xa;PUBLISH ioctl → 文件页" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f3edfa;strokeColor=#b29ac9;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1430" y="490" width="290" height="105" as="geometry"/></mxCell><mxCell id="mapping" value="内核文件注册表&#xa;namespace LBA ↔ 文件偏移&#xa;由 PG 准备的 extent 建立" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#c4cbd3;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="260" y="735" width="310" height="105" as="geometry"/></mxCell><mxCell id="driver" value="原生 Linux NVMe 驱动&#xa;标准 I/O + passthrough ioctl&#xa;SQE / CQE / PRP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff6e5;strokeColor=#ccb47b;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="650" y="735" width="310" height="105" as="geometry"/></mxCell><mxCell id="pagecache" value="Host Page Cache · HPCP&#xa;Guest 文件页缓存，4KiB 页&#xa;内核直接从接收页复制" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff6e5;strokeColor=#ccb47b;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1040" y="735" width="310" height="105" as="geometry"/></mxCell><mxCell id="receiver" value="femu_cache.ko 接收区&#xa;72MiB 固定 DMA 数据页&#xa;描述符、4 条就绪队列" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff6e5;strokeColor=#ccb47b;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1430" y="735" width="290" height="105" as="geometry"/></mxCell><mxCell id="poller" value="2 条正常 NVMe poller&#xa;8 组 I/O SQ/CQ&#xa;完成时间堆 → CQE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecf6f0;strokeColor=#8bb9a0;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="650" y="1100" width="310" height="100" as="geometry"/></mxCell><mxCell id="runtime" value="1 条 FTL + 通用 CSD runtime&#xa;&#xa;普通 I/O、内部复制与 NAND 时序&#xa;图就绪队列 / 完成事件最小堆&#xa;前驱计数、NEED_* 重入推进&#xa;FTL 调度，不常驻占用 CU" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecf6f0;strokeColor=#8bb9a0;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="650" y="1260" width="310" height="160" as="geometry"/></mxCell><mxCell id="nvm" value="可见 NVM namespace&#xa;&#xa;PG Heap、索引&#xa;HOST 普通及临时文件" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f2f4f7;strokeColor=#a3adba;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="260" y="1260" width="310" height="130" as="geometry"/></mxCell><mxCell id="spill" value="设备隐藏临时 NVM&#xa;会话 token → 隐藏区段&#xa;独立于 Linux spill 分区" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f2f4f7;strokeColor=#a3adba;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="260" y="1480" width="310" height="100" as="geometry"/></mxCell><mxCell id="fdm" value="FDM / AFDM · 64MiB&#xa;&#xa;输入页、列向量、控制、结果&#xa;CU 与 DMA 读取同一份输入" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f2f4f7;strokeColor=#a3adba;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1040" y="1260" width="310" height="130" as="geometry"/></mxCell><mxCell id="tasks" value="128 项设备填充任务记录&#xa;保存引用与范围，不复制原始块&#xa;FTL → 每 worker 的派发 lane" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecf6f0;strokeColor=#8bb9a0;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1430" y="1100" width="290" height="110" as="geometry"/></mxCell><mxCell id="dma" value="2 条后台 cache DMA worker&#xa;&#xa;按槽组原子预留、软件 DMA&#xa;链路到期后发布描述符 / 槽号&#xa;完成游标回报 FTL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecf6f0;strokeColor=#8bb9a0;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1430" y="1260" width="290" height="130" as="geometry"/></mxCell><mxCell id="cu" value="8 条 CU 线程&#xa;pending → running 领取任务&#xa;job_cond 唤醒，SO 锁外执行&#xa;每 CU 约 1/3 CPU / 10ms" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecf6f0;strokeColor=#8bb9a0;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="650" y="1480" width="310" height="100" as="geometry"/></mxCell><mxCell id="program" value="设备 SQL 程序&#xa;pg-sina-plan.so / 算子 SO&#xa;扫描、过滤、连接、聚合、排序" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecf6f0;strokeColor=#8bb9a0;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1040" y="1480" width="310" height="100" as="geometry"/></mxCell><mxCell id="workmem" value="共享 libcs-workmem.so&#xa;256MiB 总池 / 查询子配额&#xa;Hash、run、字典、游标" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f2f4f7;strokeColor=#a3adba;strokeWidth=1.5;fontColor=#233448;fontSize=16;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="components"><mxGeometry x="1430" y="1480" width="290" height="100" as="geometry"/></mxCell><mxCell id="title" value="SQLerate · 系统分层架构" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#18324c;fontStyle=1;" vertex="1" parent="notes"><mxGeometry x="40" y="24" width="1650" height="45" as="geometry"/></mxCell><mxCell id="subtitle" value="HOST 指 Guest 数据库主机；设备程序实际由容器内 FEMU 的 CU 线程执行。" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#425267;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="42" y="74" width="1680" height="24" as="geometry"/></mxCell><mxCell id="pg-band-label" value="01  PostgreSQL" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#243449;fontStyle=1;" vertex="1" parent="notes"><mxGeometry x="50" y="131" width="180" height="70" as="geometry"/></mxCell><mxCell id="pg-band-sub" value="Guest 用户态&#xa;规划、执行与数据库缓存" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#637185;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="50" y="214" width="178" height="180" as="geometry"/></mxCell><mxCell id="snia-band-label" value="02  SNIA" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#243449;fontStyle=1;" vertex="1" parent="notes"><mxGeometry x="50" y="461" width="180" height="70" as="geometry"/></mxCell><mxCell id="snia-band-sub" value="同一 PG 进程内&#xa;公共 API 与设备插件" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#637185;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="50" y="544" width="178" height="80" as="geometry"/></mxCell><mxCell id="os-band-label" value="03  Guest 内核" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#243449;fontStyle=1;" vertex="1" parent="notes"><mxGeometry x="50" y="701" width="180" height="70" as="geometry"/></mxCell><mxCell id="os-band-sub" value="原生 NVMe 驱动&#xa;DMA 接收与文件页缓存" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#637185;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="50" y="784" width="178" height="100" as="geometry"/></mxCell><mxCell id="bus-band-label" value="04  PCIe 边界" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#243449;fontStyle=1;" vertex="1" parent="notes"><mxGeometry x="50" y="951" width="180" height="55" as="geometry"/></mxCell><mxCell id="dev-band-label" value="05  模拟设备" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#243449;fontStyle=1;" vertex="1" parent="notes"><mxGeometry x="50" y="1066" width="180" height="70" as="geometry"/></mxCell><mxCell id="dev-band-sub" value="FEMU / QEMU 进程&#xa;FTL、通用 runtime、CU&#xa;及后台 cache DMA" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#637185;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="50" y="1149" width="178" height="615" as="geometry"/></mxCell><mxCell id="bus-note" value="正常 NVMe I/O、结果读取与主动缓存 DMA 共用 PCIe 带宽；填充不再使用 AER / 每块 READ / ACK。" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#425267;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="280" y="957" width="1380" height="30" as="geometry"/></mxCell><mxCell id="device-note" value="边界说明：通用 runtime 只理解 LOAD / EXEC / STORE 与依赖，不理解 SQL。&#xa;输入的覆盖/释放需满足 CU 与实际 DMA 的安全条件；无需等待 Guest 完成 HPCP/DCP 安装。&#xa;设备任务元数据使用 FEMU 普通内存；Guest 接收槽不计入 FDM 或设备 workmem。" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#425267;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="260" y="1640" width="1430" height="85" as="geometry"/></mxCell><mxCell id="legend" value="蓝：查询请求、计算与正常 I/O     绿：HPCP 数据与发布     橙：DCP / 工作状态     灰虚线：观测、归属或辅助控制" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#425267;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="55" y="1808" width="1680" height="35" as="geometry"/></mxCell><mxCell id="legend2" value="设备常用线程：1 FTL + 8 CU + 2 NVMe poller + 2 cache DMA；HOST 线程不计入 CU。" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#425267;fontStyle=0;" vertex="1" parent="notes"><mxGeometry x="55" y="1850" width="1680" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="population" name="02 HPCP-DCP 队列与槽位"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="background" value="分层背景" parent="0"/><mxCell id="connections" value="接口与数据流" parent="0"/><mxCell id="components" value="组件与队列" parent="0"/><mxCell id="notes" value="文字说明" parent="0"/><mxCell id="q-dev" value="" style="rounded=1;arcSize=8;fillColor=#f3f9f5;strokeColor=#d7dfe8;" vertex="1" parent="background"><mxGeometry x="30" y="125" width="1740" height="245" as="geometry"/></mxCell><mxCell id="dma-band" value="" style="rounded=1;arcSize=8;fillColor=#eef7f2;strokeColor=#d7dfe8;" vertex="1" parent="background"><mxGeometry x="30" y="410" width="1740" height="235" as="geometry"/></mxCell><mxCell id="slots-band" value="" style="rounded=1;arcSize=8;fillColor=#fffaf0;strokeColor=#d7dfe8;" vertex="1" parent="background"><mxGeometry x="30" y="735" width="1740" height="245" as="geometry"/></mxCell><mxCell id="guest-workers" value="" style="rounded=1;arcSize=8;fillColor=#f8f4fc;strokeColor=#d7dfe8;" vertex="1" parent="background"><mxGeometry x="30" y="1020" width="1740" height="175" as="geometry"/></mxCell><mxCell id="targets" value="" style="rounded=1;arcSize=8;fillColor=#f6f7fa;strokeColor=#d7dfe8;" vertex="1" parent="background"><mxGeometry x="30" y="1240" width="1740" height="200" as="geometry"/></mxCell><mxCell id="record" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#28866a;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=13;fontColor=#28866a;fontFamily=Noto Sans CJK SC;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=7;" edge="1" parent="connections" source="input" target="pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="schedule" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#28866a;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=13;fontColor=#28866a;fontFamily=Noto Sans CJK SC;labelBackgroun